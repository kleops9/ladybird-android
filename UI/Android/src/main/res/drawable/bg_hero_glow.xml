<!-- The violet glow in the top right corner of the ladybird.org hero. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/page_bg" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0"
                android:endColor="@android:color/transparent"
                android:gradientRadius="320dp"
                android:startColor="@color/hero_glow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
