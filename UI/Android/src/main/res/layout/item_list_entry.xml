<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <TextView
            android:id="@+id/entry_letter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_letter"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/entry_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_letter"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/entry_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Ladybird.Body"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/entry_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Ladybird.Muted" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/entry_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:visibility="gone"
            app:indicatorColor="@color/accent"
            app:trackColor="@color/border_light"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/entry_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/clear"
        android:scaleType="center"
        android:src="@drawable/ic_close" />
</LinearLayout>
