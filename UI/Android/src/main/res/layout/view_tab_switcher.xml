<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switcher_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/switcher_new_tab"
            style="@style/ToolbarIconButton"
            android:contentDescription="@string/new_tab"
            android:src="@drawable/ic_add" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <!-- Normal and incognito tabs: a pill segmented control. -->
            <LinearLayout
                android:id="@+id/switcher_segments"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_segment_group"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/switcher_segment_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_segment"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/switcher_segment_incognito"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_segment"
                    android:contentDescription="@string/incognito"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_incognito" />

                    <TextView
                        android:id="@+id/switcher_incognito_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <ImageButton
            android:id="@+id/switcher_menu"
            style="@style/ToolbarIconButton"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/switcher_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="10dp" />

        <TextView
            android:id="@+id/switcher_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@drawable/ic_incognito"
            android:drawablePadding="12dp"
            android:text="@string/incognito_switcher_empty"
            android:textAppearance="@style/TextAppearance.Ladybird.Muted"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
