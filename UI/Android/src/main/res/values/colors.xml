<?xml version="1.0" encoding="utf-8"?>
<!--
    Colors follow the ladybird.org design tokens (light-dark() pairs; the dark halves are in values-night).
    Brand colors are the same in both themes.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand -->
    <color name="brand_indigo">#FF2A1373</color>
    <color name="brand_indigo_900">#FF190C4A</color>
    <color name="brand_slate">#FF6D98CC</color>
    <color name="brand_violet">#FF8A64E5</color>
    <color name="brand_violet_100">#FFCAB5FF</color>
    <color name="brand_violet_10">#FFE0D4FF</color>

    <!-- Site tokens: bg-page, bg-subtle, border, border-light, text-*, color-accent -->
    <color name="page_bg">#FFFFFFFF</color>
    <color name="subtle_bg">#FFF6F6F8</color>
    <color name="border">#FFDCDCE2</color>
    <color name="border_light">#FFEBEBEF</color>
    <color name="text_primary">#FF0A0A0A</color>
    <color name="text_secondary">#FF5A5A63</color>
    <color name="text_strong">#FF2E2E33</color>
    <color name="accent">#FF6A39DB</color>
    <color name="accent_hover">#FF3C28A1</color>
    <color name="on_accent">#FFFFFFFF</color>
    <color name="hero_glow">#248A64E5</color>
    <color name="accent_tint">#146A39DB</color>

    <!-- Browser chrome, built from the tokens above -->
    <color name="toolbar_bg">@color/page_bg</color>
    <color name="omnibox_bg">@color/subtle_bg</color>
    <color name="icon_tint">@color/text_strong</color>
    <color name="divider">@color/border_light</color>
    <color name="switcher_bg">@color/subtle_bg</color>
    <color name="card_bg">@color/page_bg</color>
    <color name="card_selected">@color/accent</color>
    <color name="menu_bg">@color/page_bg</color>
    <color name="tile_bg">@color/subtle_bg</color>

    <!-- Incognito: the site's indigo brand band -->
    <color name="incognito_toolbar">@color/brand_indigo_900</color>
    <color name="incognito_omnibox">#FF2A1A66</color>
    <color name="incognito_border">#FF3B2A85</color>
    <color name="incognito_text">#FFFFFFFF</color>
    <color name="incognito_text_secondary">@color/brand_violet_10</color>
    <!-- The site's download button: color-mix(accent, white 14%) to color-mix(accent, indigo 22%) -->
    <color name="cta_top">#FF7F55E0</color>
    <color name="cta_bottom">#FF5C31C4</color>
</resources>
